# LF line endings in the repository. The hash (SHA-256) of the pre-registration must
# be identical on every computer: on Windows, CRLF line endings would change it.
* text=auto eol=lf

# Windows scripts: CRLF, otherwise cmd.exe may fail to run them
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: git never converts them
# Images and video
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.mp4 binary
*.webm binary
# Documents and fonts
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
# Archives and data
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
*.parquet binary
*.sqlite binary
*.db binary
*.wasm binary
# Timestamp proofs, signatures and certificates
*.ots binary
*.tsq binary
*.tsr binary
*.sig binary
*.gpg binary
*.der binary
*.p7s binary
