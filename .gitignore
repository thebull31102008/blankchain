# Secrets: never in the repository
.env
.env.*
*.env
.envrc
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
keystore/
keystores/
UTC--*
id_rsa*
id_ecdsa*
id_ed25519*
!*.pub
.secret
*.mnemonic
mnemonic.txt
secrets/
!.env.example

# Public certificates of the timestamping authorities:
# they are needed to verify the proofs of the pre-registration, so they stay
!docs/preregistration/**/*.pem

# Dependencies and generated files
# (the build folders of each part go in the .gitignore of its own folder, when it is created)
node_modules/
*.tsbuildinfo
.eslintcache

# Local tool settings
.claude/settings.local.json
CLAUDE.local.md
.idea/
*.log

# System files
.DS_Store
Thumbs.db
desktop.ini
